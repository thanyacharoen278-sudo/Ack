-------------------------------------------------
-- RAID LOOP
-------------------------------------------------
task.spawn(function()
    while true do
        if not _G.AutoRaid then
            task.wait(0.3)
        else
            pcall(function()
                local islandCF = RaidIslands[raidIslandIndex]
                if not islandCF then return end
                local h = HRP()
                if not h then return end

                if _G.AutoEquip then
                    RefreshWeapon()
                    EquipTool()
                end
                EnableHaki()

                local toIsland = (h.Position - islandCF.Position).Magnitude
                if not raidArrived then
                    if toIsland > ARRIVE_DIST then
                        TweenTo(islandCF * CFrame.new(0, 8, 0))
                        return
                    end
                    raidArrived = true
                    raidNoMobTimer = 0
                end

                local mob = FindRaidMobNear(islandCF)
                if mob then
                    raidNoMobTimer = 0
                    ExpandHitbox(mob)
                    FloatOn(mob)
                    AttackNoCoolDown()
                else
                    raidNoMobTimer = raidNoMobTimer + math.max(FAST_DELAY, 0.1)
                    ZeroVel()
                    if (h.Position - islandCF.Position).Magnitude > 12 then
                        TweenTo(islandCF * CFrame.new(0, 8, 0))
                    end
                    if raidNoMobTimer >= RAID_NO_MOB_WAIT then
                        GoNextRaidIsland()
                    end
                end
            end)
            task.wait(FAST_DELAY)
        end
    end
end)

RunService.Stepped:Connect(function()
    if not _G.AutoRaid then return end
    NoCollide()
    ZeroVel()
end)

