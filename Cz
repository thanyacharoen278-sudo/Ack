-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function Char()
    return LP.Character
end

local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function CancelTween(t)
    pcall(function()
        if t then t:Cancel() end
    end)
end

local function ZeroVel()
    pcall(function()
        local h = HRP()
        if h then
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function RestorePlayer()
    pcall(function()
        CancelTween(floatTween)
        CancelTween(moveTween)
        floatTween, moveTween = nil, nil
        local h = HRP()
        local hum = Hum()
        if h then
            ZeroVel()
            for _, x in ipairs(h:GetChildren()) do
                if x:IsA("BodyVelocity") or x:IsA("BodyGyro") or x:IsA("BodyPosition") then
                    x:Destroy()
                end
            end
            h.CanCollide = true
        end
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.PlatformStand = false
            hum.AutoRotate = true
        end
        local c = Char()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = true
                end
            end
        end
    end)
end

local function NoCollide()
    pcall(function()
        local c = Char()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end)
end

local function RefreshWeapon()
    pcall(function()
        local bag = LP:FindFirstChild("Backpack")
        local char = Char()
        local function scan(folder)
            if not folder then return false end
            for _, t in ipairs(folder:GetChildren()) do
                if t:IsA("Tool") then
                    local tip = tostring(t.ToolTip or "")
                    if ChooseWeapon == "Melee" and (tip == "Melee" or t.Name == "Combat") then
                        SelectWeapon = t.Name
                        return true
                    elseif ChooseWeapon == "Sword" and tip == "Sword" then
                        SelectWeapon = t.Name
                        return true
                    elseif ChooseWeapon == "Blox Fruit" and tip == "Blox Fruit" then
                        SelectWeapon = t.Name
                        return true
                    end
                end
            end
            return false
        end
        if char and scan(char) then return end
        scan(bag)
    end)
end

local function EquipTool()
    pcall(function()
        local char = Char()
        local hum = Hum()
        if not char or not hum then return end
        if char:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        local tool = bag:FindFirstChild(SelectWeapon)
        if tool then
            hum:EquipTool(tool)
            return
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
    end)
end

local function EnableHaki()
    if not _G.AutoHaki then return end
    pcall(function()
        local c = Char()
        if c and not c:FindFirstChild("HasBuso") then
            RS.Remotes.CommF_:InvokeServer("Buso")
        end
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if not cf then return end
        local mod = require(cf)
        AC = mod
        if typeof(mod) == "function" and debug and debug.getupvalues then
            local ok, ups = pcall(debug.getupvalues, mod)
            if ok and ups and ups[2] then
                AC = ups[2]
            end
        end
    end)
end

local function ExpandHitbox(mob)
    pcall(function()
        local root = mob and mob:FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = Vector3.new(40, 40, 40)
            root.Transparency = 1
            root.CanCollide = false
        end
        local hum = mob and mob:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end
    end)
end

local function TweenTo(cf)
    local h = HRP()
    if not h or typeof(cf) ~= "CFrame" then return end
    CancelTween(moveTween)
    local dist = (h.Position - cf.Position).Magnitude
    if dist <= 3 then
        h.CFrame = cf
        ZeroVel()
        return
    end
    local t = math.clamp(dist / TWEEN_SPEED, 0.15, 6)
    moveTween = TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    moveTween:Play()
end

local function FloatOn(mob)
    local h = HRP()
    local eh = mob and mob:FindFirstChild("HumanoidRootPart")
    if not h or not eh then return end
    CancelTween(floatTween)
    local goal = eh.CFrame * CFrame.new(0, FLOAT_HEIGHT, 0)
    local look = CFrame.lookAt(goal.Position, eh.Position)
    local dist = (h.Position - look.Position).Magnitude
    if dist <= 2.5 then
        h.CFrame = look
        ZeroVel()
        return
    end
    floatTween = TweenService:Create(
        h,
        TweenInfo.new(FLOAT_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = look }
    )
    floatTween:Play()
    ZeroVel()
end

-------------------------------------------------
-- FAST ATTACK
-------------------------------------------------
local RegisterAttack, RegisterHit
local FA_Ready = false

local function InitFastAttack()
    pcall(function()
        local Modules = RS:FindFirstChild("Modules")
        if not Modules then return end
        local Net = Modules:FindFirstChild("Net")
        if not Net then return end
        RegisterAttack = Net:FindFirstChild("RE/RegisterAttack") or Net["RE/RegisterAttack"]
        RegisterHit = Net:FindFirstChild("RE/RegisterHit") or Net["RE/RegisterHit"]
        FA_Ready = (RegisterAttack ~= nil and RegisterHit ~= nil)
    end)
end

local function FastAttackHit()
    if not _G.FastAttack or not FA_Ready then return end
    pcall(function()
        local me = HRP()
        local myChar = Char()
        local folder = workspace:FindFirstChild("Enemies")
        if not me or not folder then return end
        local others = {}
        local base = nil
        for _, enemy in ipairs(folder:GetChildren()) do
            if enemy ~= myChar then
                local head = enemy:FindFirstChild("Head")
                    or enemy:FindFirstChild("UpperTorso")
                    or enemy:FindFirstChild("HumanoidRootPart")
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    local d = (me.Position - head.Position).Magnitude
                    if d < FA_DISTANCE then
                        table.insert(others, { enemy, head })
                        base = base or head
                    end
                end
            end
        end
        if #others > 0 and base then
            RegisterAttack:FireServer(1e-9)
            RegisterHit:FireServer(base, others)
        end
    end)
end

local function AttackNoCoolDown()
    pcall(function()
        if not AC then LoadCombat() end
        local ctrl = AC
        if ctrl and ctrl.activeController then
            ctrl = ctrl.activeController
        end
        if ctrl then
            ctrl.timeToNextAttack = 0
            ctrl.attacking = false
            ctrl.blocking = false
            ctrl.hitboxMagnitude = HITBOX
            if type(ctrl.attack) == "function" then
                ctrl:attack()
            end
        end
    end)
    pcall(function()
        local tool = Char() and Char():FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)
    FastAttackHit()
end

-------------------------------------------------
-- RAID LOGIC
-------------------------------------------------
local function FindRaidMobNear(cf)
    local best, bestD = nil, RAID_ISLAND_RANGE
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, e in ipairs(folder:GetChildren()) do
        local hum = e:FindFirstChildOfClass("Humanoid")
        local root = e:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local d = (root.Position - cf.Position).Magnitude
            if d < bestD then
                bestD = d
                best = e
            end
        end
    end
    return best
end

local function GoNextRaidIsland()
    raidIslandIndex = raidIslandIndex + 1
    raidArrived = false
    raidNoMobTimer = 0
    if raidIslandIndex > #RaidIslands then
        raidIslandIndex = 1
        _G.AutoRaid = false
        RestorePlayer()
        print("[Deku Raid] ครบเกาะ 5 · ปิด Auto Raid")
    else
        print("[Deku Raid] ไปเกาะ", raidIslandIndex)
    end
end

